# --- Jazyl backend ---
APP_ENV=development                 # production enables strict checks
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080   # public URL OpenWA posts webhooks to
LOG_LEVEL=info

# PostgreSQL (Neon). POSTRE_DATABASE_API is accepted as an alias of DATABASE_URL.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require
# DATABASE_MIGRATE_URL=            # direct (non-pooler) URL; derived automatically for Neon

JWT_SECRET=                        # 32+ random bytes: openssl rand -base64 48
DATA_ENCRYPTION_KEY=               # 32+ random bytes, encrypts 2FA secrets: openssl rand -base64 48 (never rotate without re-enrolling 2FA)
# REQUIRE_SUPERADMIN_MFA=true       # default: true in production (cannot be disabled there), false in development
# LOGIN_RATE_PER_MINUTE=20          # login/2FA attempts per client IP; behind the dashboard set TRUSTED_PROXY=true
DASHBOARD_ORIGINS=http://localhost:3000

# First superadmin (created once if none exists)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- WhatsApp via OpenWA ---
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=7aBh4AnZHpFGcm6BtpmyJthX/bGUDEJRKDmt5o747fw=
OPENWA_WEBHOOK_SECRET=ua7&yq4bJO%]Y$G0
SEND_MIN_INTERVAL=12s              # pause between two messages from one number (anti-ban)
SEND_JITTER=10s

WORKERS_ENABLED=true
METRICS_TOKEN=                     # if set, /metrics requires "Authorization: Bearer <token>"
